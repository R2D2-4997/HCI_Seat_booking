{
  "manifest_version": 3,
  "name": "TactileSeat Extension",
  "version": "1.0",
  "description": "Cartographie spatiale et haptique de sièges pour Dot Pad",
  "permissions": [
    "activeTab",
    "scripting",
    "sidePanel"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "TactileSeat"
  },
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "content/state.js",
        "content/i18n.js",
        "content/speech.js",
        "content/dom-utils.js",
        "content/extract.js",
        "content/layout.js",
        "content/backend-client.js",
        "content/overlay.js",
        "content/actions.js",
        "content/dotpad-bridge.js",
        "content/navigation.js",
        "content/main.js"
      ]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}
