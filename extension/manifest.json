{
  "manifest_version": 3,
  "name": "TactileSeat Extension",
  "version": "1.0",
  "description": "Cartographie spatiale et haptique de sièges pour Dot Pad",
  "permissions": [
    "activeTab",
    "scripting"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "TactileSeat"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  }
}